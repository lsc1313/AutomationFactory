# Do not commit actual credentials. These are illustrative placeholders.
REVENUE_ADMIN_EMAIL=admin@example.com
REVENUE_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_16_CHARACTER_SECRET
REVENUE_APP_PORT=8040
REVENUE_BIND=127.0.0.1
REVENUE_DB=/absolute/private/path/app.json
REVENUE_OUT=/absolute/private/path/output
# Public HTTPS deployment requires trusted reverse proxy, HTTPS and secret cookies:
# REVENUE_PUBLIC_HOST=your-domain.example
# REVENUE_SECURE_COOKIE=1
# REVENUE_TRUST_PROXY=1

# Optional AI copy polishing (uses Gemini API; no key -> offline fallback):
# REVENUE_GEMINI_API_KEY=YOUR_KEY
# REVENUE_GEMINI_MODEL=gemini-3.8-flash